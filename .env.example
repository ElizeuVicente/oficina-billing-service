# Copie para .env e preencha SOMENTE com credenciais de teste.
# .env e ignorado pelo Git; nunca versione valores reais.

# Token interno entre os servicos (minimo 32 caracteres).
BILLING_SERVICE_TOKEN=substitua-por-um-token-local-com-32-caracteres

# Checkout Pro / Mercado Pago Sandbox. Obtenha no painel do desenvolvedor.
BILLING_MERCADOPAGO_ACCESS_TOKEN=
BILLING_MERCADOPAGO_WEBHOOK_SECRET=
BILLING_MERCADOPAGO_COLLECTOR_ID=

# URL HTTPS publica do tunel, encaminhando para /webhooks/mercadopago local.
# Exemplo: https://seu-endereco-exemplo/webhooks/mercadopago
BILLING_MERCADOPAGO_NOTIFICATION_URL=

# Ative apenas durante a validacao de sandbox.
BILLING_MERCADOPAGO_CHECKOUT_ENABLED=false
# Quando true, uma aprovacao de orcamento agenda uma preferencia automaticamente.
# Requer BILLING_MERCADOPAGO_CHECKOUT_ENABLED=true, webhook e reconciliacao habilitados.
BILLING_MERCADOPAGO_CHECKOUT_AUTO_ENABLED=false
BILLING_MERCADOPAGO_WEBHOOK_ENABLED=false
BILLING_MERCADOPAGO_RECONCILIATION_ENABLED=false
BILLING_MERCADOPAGO_REFUNDS_ENABLED=false

# Mantenha false em sandbox. Nao use este arquivo para producao.
BILLING_MERCADOPAGO_LIVE_MODE=false
